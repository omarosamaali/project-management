APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ACADEMY_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Optional: path to ffmpeg binary (required to bake watermarks into videos)
# On Windows use forward slashes, e.g. C:/ffmpeg/bin/ffmpeg.exe
# FFMPEG_PATH=ffmpeg
# WATERMARK_OPACITY=0.38
# WATERMARK_WIDTH_RATIO=0.18
# WATERMARK_BAKE=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Gmail: فعّل 2FA ثم أنشئ App Password من https://myaccount.google.com/apppasswords
# ضع البريد الكامل في MAIL_USERNAME وكلمة App Password (16 حرف) في MAIL_PASSWORD بدون مسافات

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Recorded courses: require finishing each lesson/exam before the next path step (default: true)
COURSE_PATH_REQUIRE_LESSON_COMPLETE=true

# Jitsi Meet (free public server by default — override for self-hosted)
COURSE_MEETING_OPEN_BEFORE_MINUTES=30

# Embedded private-course meetings (HMAC). Enable toggle in Academy settings (testing).
# Point at your meeting app (local Docker, ngrok, or production).
MEETING_BASE_URL=https://cleo-swirly-gloomfully.ngrok-free.dev
MEETING_API_KEY=edu_platform_dev_key
MEETING_API_SECRET=edu_platform_dev_secret_change_me_32chars_min
MEETING_WEBHOOK_SECRET=edu_webhook_secret_change_me_16
# true for ngrok / public HTTPS; false only for local self-signed meeting Docker TLS
MEETING_SSL_VERIFY=true

ZIINA_BASE_URL=https://api-v2.ziina.com/api
ZIINA_API_KEY=
ZIINA_TEST_MODE=true
ZIINA_WEBHOOK_SECRET=

# Laravel Reverb (realtime chat + exam redirects). Run: php artisan reverb:start
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
